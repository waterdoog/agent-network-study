# OpenRouter. Any model the harness can reach through the chat-completions API
# works; the study was run entirely on the first one so that a condition never
# differs from another in which model answered.
#
# Nothing in the harness loads this file by itself. Either export the variables
# or run with Node's built-in loader:  node --env-file=.env src/run.js --smoke
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...

# Primary. Every agent in every arm, so model is never a confound.
# (src/lib/openrouter.js reads STUDY_MODEL; an earlier draft of this file said
# RAC_MODEL, which the code never looked at.)
STUDY_MODEL=deepseek/deepseek-v4-flash

# Replication. Runs the same grid on a second family to show a result is not
# one model's habit.
# STUDY_MODEL=z-ai/glm-4.6
